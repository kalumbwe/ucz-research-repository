# ============================================================
# UCZ University Research Repository — environment configuration
# Copy this file to ".env" for local development.
# On Render, set these as Environment Variables in the dashboard
# instead of uploading a .env file (see README.md).
# ============================================================

APP_NAME="UCZ University Research Repository"
# production | local
APP_ENV=local
# Full public URL of the site, no trailing slash. Used for links/emails.
APP_URL=http://localhost:8080

# --- Database -------------------------------------------------
# Render provides a single DATABASE_URL for its managed Postgres
# instance (Internal Database URL). If DATABASE_URL is set, the
# discrete DB_* values below are ignored.
DATABASE_URL=

# Discrete fallback (used for local Postgres, or XAMPP + a local
# Postgres install). Not needed if DATABASE_URL is set.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ucz_research
DB_USER=postgres
DB_PASSWORD=
# Leave blank for local/internal connections. Set to "require" if
# your database enforces SSL (e.g. an external Render DB URL).
DB_SSLMODE=

# --- File storage ----------------------------------------------
# Absolute path where uploaded PDFs are stored. On Render this
# should be the mount path of your persistent Disk.
STORAGE_PATH=/var/www/html/storage/uploads
MAX_UPLOAD_MB=25

# --- First-time install wizard (public/install.php) -------------
# Set this to a long random string before deploying. You will be
# asked to enter it once, in your browser, to create the first
# admin account. Remove it (or change it) again once installed.
INSTALL_KEY=change-this-before-you-deploy
